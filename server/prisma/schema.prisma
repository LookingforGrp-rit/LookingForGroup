generator client {
  provider        = "prisma-client-js"
  output          = "../src/models/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Blocklist {
  blockerId Int    @map("blocker_id")
  blockedId Int    @map("blocked_id")
  blockId   String @id @default(uuid()) @map("block_id")
  blocked   Users  @relation("UserToBlocked", fields: [blockedId], references: [userId], onDelete: Cascade, map: "user_to_blocked_FK")
  blocker   Users  @relation("UserToBlocker", fields: [blockerId], references: [userId], onDelete: Cascade, map: "user_to_blocker_FK")

  @@index([blockedId], map: "user_to_blocked_FK")
  @@index([blockerId], map: "user_to_blocker_FK")
  @@map("blocklist")
}

model Mediums {
  mediumId Int        @id @default(autoincrement()) @map("medium_id")
  label    String     @unique @db.VarChar(50)
  projects Projects[] @relation("mediumstoprojects")

  @@map("mediums")
}

model Roles {
  roleId  Int       @id @default(autoincrement()) @map("title_id")
  label   String    @unique @db.VarChar(50)
  jobs    Jobs[]
  members Members[]

  @@map("roles")
}

model Jobs {
  jobId         Int              @id @default(autoincrement()) @map("job_id")
  projectId     Int              @map("project_id")
  roleId        Int              @map("role_id")
  contactUserId Int              @map("contact_user_id")
  availability  JobsAvailability
  location      JobsLocation
  compensation  JobsCompensation
  description   String           @default("") @db.VarChar(500)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamp(0)
  jobStart      DateTime         @default(dbgenerated("'1900-01-01 00:00:00'")) @db.DateTime(0)
  jobEnd        DateTime         @default(dbgenerated("'1900-01-01 00:00:00'")) @db.DateTime(0)
  jobSkills     JobSkills[]
  projects      Projects         @relation(fields: [projectId], references: [projectId], onDelete: Cascade, map: "FK2_project_id")
  roles         Roles            @relation(fields: [roleId], references: [roleId], onDelete: Cascade, map: "FK_jobs_job_titles")
  contact       Members          @relation(fields: [projectId, contactUserId], references: [projectId, userId], onDelete: Cascade)

  @@index([projectId], map: "FK2_project_id")
  @@index([roleId], map: "FK_jobs_job_titles")
  @@index([projectId, contactUserId], map: "jobs_project_id_contact_user_id_fkey")
  @@map("jobs")
}

model Majors {
  majorId Int     @id @default(autoincrement()) @map("major_id")
  label   String  @unique @db.VarChar(50)
  users   Users[] @relation("majorstousers")

  @@map("majors")
}

model Members {
  projectId         Int        @map("project_id")
  userId            Int        @map("user_id")
  roleId            Int        @map("title_id")
  profileVisibility Visibility @default(public) @map("profile_visibility")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  jobs              Jobs[]
  roles             Roles      @relation(fields: [roleId], references: [roleId], onDelete: Cascade, map: "FK_members_job_titles")
  projects          Projects   @relation(fields: [projectId], references: [projectId], onDelete: Cascade, map: "FK_members_projects")
  users             Users      @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "FK_members_users")

  @@id([projectId, userId])
  @@index([roleId], map: "FK_members_job_titles")
  @@index([userId], map: "FK_members_users")
  @@map("members")
}

model Notifications {
  notificationId String   @id @unique @default(uuid()) @map("notification_id")
  receiverId     Int      @map("receiver_id")
  subjectLine    String   @map("subject_line") @db.VarChar(300)
  message        String   @map("message") @db.VarChar(2000)
  hasBeenRead    Boolean  @default(false) @map("has_been_read")
  timeSent       DateTime @map("time_sent")
  isGlobal       Boolean  @default(false) @map("is_global")
  receiver       Users    @relation("FK_receiver_to_notification", fields: [receiverId], references: [userId], onDelete: Cascade)

  @@index([receiverId], map: "notifications_receiver_id_fkey")
  @@map("notifications")
}

model MemberRequests {
  requestId           Int                 @id @default(autoincrement()) @map("request_id")
  prospectiveMemberId Int                 @map("prospective_member_id")
  projectId           Int                 @map("project_id")
  roleId              Int                 @map("role_id")
  sentFromProject     Boolean             @map("sent_from_project")
  requestStatus       MemberRequestStatus @map("request_status")
  users               Users               @relation(fields: [prospectiveMemberId], references: [userId], onDelete: Cascade, map: "prospective_member_user")
  projects            Projects            @relation(fields: [projectId], references: [projectId], onDelete: Cascade, map: "request_project_id")

  @@unique([prospectiveMemberId, projectId, roleId])
  @@index([projectId], map: "request_project_id")
  @@index([prospectiveMemberId], map: "request_prospective_id")
  @@map("member_requests")
}

model ProjectFollowings {
  userId     Int      @map("user_id")
  projectId  Int      @map("project_id")
  followedAt DateTime @default(now()) @map("followed_at") @db.Timestamp(0)
  projects   Projects @relation(fields: [projectId], references: [projectId], onDelete: Cascade, map: "FK_project_followings_projects")
  users      Users    @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "FK_project_followings_users")

  @@id([userId, projectId])
  @@index([projectId], map: "FK_project_followings_projects")
  @@index([userId], map: "FK_project_followings_users")
  @@map("project_followings")
}

model ProjectImages {
  imageId    Int       @id @default(autoincrement()) @map("image_id")
  image      String    @db.VarChar(500)
  altText    String    @db.VarChar(150)
  position   Int
  projectId  Int       @map("project_id")
  projects   Projects  @relation("ProjectImages", fields: [projectId], references: [projectId], onDelete: Cascade, map: "FK_project_images_projects")
  isThumbFor Projects?

  @@index([projectId], map: "FK_project_images_projects")
  @@map("project_images")
}

model ProjectVideos {
  videoId   Int      @id @default(autoincrement()) @map("video_id")
  videoUrl  String   @map("video_url") @db.VarChar(500)
  title     String   @db.VarChar(150)
  position  Int
  projectId Int      @map("project_id")
  projects  Projects @relation("ProjectVideos", fields: [projectId], references: [projectId], onDelete: Cascade, map: "FK_project_videos_projects")

  @@index([projectId], map: "FK_project_videos_projects")
  @@map("project_videos")
}

model ProjectSocials {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  websiteId Int      @map("website_id")
  url       String   @db.VarChar(500)
  alias     String   @db.VarChar(50)
  projects  Projects @relation(fields: [projectId], references: [projectId], onDelete: Cascade, map: "FK_project_socials_projects")
  socials   Socials  @relation(fields: [websiteId], references: [websiteId], onDelete: Cascade, map: "FK_project_socials_socials")

  @@index([projectId], map: "FK_project_socials_projects")
  @@index([websiteId], map: "FK_project_socials_socials")
  @@map("project_socials")
}

model ProjectTags {
  projectId    Int      @map("project_id")
  tagId        Int      @map("tag_id")
  displayOrder Int      @default(0) @map("display_order") @db.UnsignedInt
  project      Projects @relation(fields: [projectId], references: [projectId], onDelete: Cascade, map: "FK_project_tags_project")
  tag          Tags     @relation(fields: [tagId], references: [tagId], onDelete: Cascade, map: "FK_project_tags_tag")

  @@id([projectId, tagId])
  @@index([tagId], map: "FK_project_tags_tag_id")
  @@map("project_tags")
}

model Projects {
  projectId         Int                       @id @unique @default(autoincrement()) @map("project_id")
  title             String                    @db.VarChar(100)
  hook              String                    @default("") @db.VarChar(600)
  description       String                    @default("") @db.VarChar(2000)
  thumbnailId       Int?                      @unique @map("thumbnail_id")
  context           ProjectsContext?
  status            ProjectsStatus            @default(Planning)
  audience          String                    @default("") @db.VarChar(300)
  userId            Int                       @map("user_id")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamp(0)
  globalVisibility  Visibility                @map("global_visibility")
  approved          Boolean                   @default(false)
  jobs              Jobs[]
  memberRequest     MemberRequests[]
  members           Members[]
  projectFollowings ProjectFollowings[]
  projectImages     ProjectImages[]           @relation("ProjectImages")
  projectSocials    ProjectSocials[]
  tags              ProjectTags[]
  projectVideos     ProjectVideos[]           @relation("ProjectVideos")
  users             Users                     @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "FK_user_id")
  thumbnail         ProjectImages?            @relation(fields: [thumbnailId], references: [imageId])
  awaitingapproval  ProjectsAwaitingApproval?
  report            ReportProject[]
  mediums           Mediums[]                 @relation("mediumstoprojects")

  @@index([userId], map: "FK_user_id")
  @@map("projects")
}

model ProjectsAwaitingApproval {
  projectId Int      @id @map("project_id")
  project   Projects @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@map("projects_awaiting_approval")
}

model ReportProject {
  reportId   Int      @id @default(autoincrement()) @map("report_id")
  userId     Int      @map("user_id")
  projectId  Int      @map("project_id")
  reportText String   @map("report_text") @db.VarChar(2000)
  projects   Projects @relation(fields: [projectId], references: [projectId], onDelete: Cascade, map: "FK_project_report_projects")
  users      Users    @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "FK_project_report_users")

  @@index([userId], map: "FK_project_report_users")
  @@index([projectId], map: "FK_project_report_projects")
  @@map("report_project")
}

model ReportUser {
  reportId   Int     @id @default(autoincrement()) @map("report_id")
  reporterId Int     @map("reporter_id")
  reportedId Int     @map("reported_id")
  reportText String  @map("report_text") @db.VarChar(2000)
  active     Boolean @default(true)
  reported   Users   @relation("reported_id", fields: [reportedId], references: [userId], onDelete: Cascade, map: "FK_user_report_reported")
  reporter   Users   @relation("reporter_id", fields: [reporterId], references: [userId], onDelete: Cascade, map: "FK_user_report_reporter")

  @@index([reporterId], map: "FK_user_report_reporter")
  @@index([reportedId], map: "FK_user_report_reported")
  @@map("report_user")
}

model ReportBug {
  reportId   Int      @id @default(autoincrement()) @map("report_id")
  userId     Int      @map("user_id")
  reportText String   @map("report_text") @db.VarChar(2000)
  isResolved Boolean  @default(false) @map("is_resolved")
  modNotes   String   @map("mod_notes") @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at")
  users      Users    @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "FK_bug_report_user")

  @@index([userId], map: "FK_project_report_user")
  @@map("report_bug")
}

model Socials {
  websiteId      Int              @id @default(autoincrement()) @map("website_id")
  label          String           @unique @db.VarChar(50)
  projectSocials ProjectSocials[]
  userSocials    UserSocials[]

  @@map("socials")
}

model Skills {
  skillId    Int          @id @default(autoincrement()) @map("skill_id")
  label      String       @db.VarChar(50)
  type       String       @db.VarChar(50)
  category   String?      @db.VarChar(50)
  jobSkills  JobSkills[]
  userSkills UserSkills[]

  @@unique([label, type])
  @@map("skills")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  gid       String   @default("federalist papers")
  expiresAt DateTime

  @@map("session")
}

model Tags {
  tagId       Int           @id @default(autoincrement()) @map("tag_id")
  label       String        @db.VarChar(50)
  type        String        @db.VarChar(50)
  category    String?       @db.VarChar(50)
  projectTags ProjectTags[]
  users       Users[]       @relation("tag_blacklist")

  @@unique([label, type])
  @@map("tags")
}

model UserBlacklist {
  googleId  String @id @map("google_id")
  banReason String @map("ban_reason")
  user      Users  @relation(fields: [googleId], references: [googleId], onDelete: Cascade)

  @@map("user_blacklist")
}

model UserFollowings {
  senderId     Int      @map("sender_id")
  receiverId   Int      @map("receiver_id")
  followedAt   DateTime @default(now()) @map("followed_at") @db.Timestamp(0)
  receiverUser Users    @relation("receiver_user", fields: [receiverId], references: [userId], onDelete: Cascade, map: "FK_user_followings_receiver")
  senderUser   Users    @relation("sender_user", fields: [senderId], references: [userId], onDelete: Cascade, map: "FK_user_followings_sender")

  @@id([senderId, receiverId])
  @@index([senderId], map: "FK_user_followings_sender")
  @@index([receiverId], map: "FK_user_followings_receiver")
  @@map("user_followings")
}

model UserSkills {
  userId      Int              @map("user_id")
  skillId     Int              @map("skill_id")
  position    Int
  proficiency SkillProficiency
  skills      Skills           @relation(fields: [skillId], references: [skillId], onDelete: Cascade, map: "FK_user_skills_skills")
  users       Users            @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "FK_user_skills_users")

  @@id([userId, skillId])
  @@index([skillId], map: "FK_user_skills_skills")
  @@index([userId], map: "FK_user_skills_users")
  @@map("user_skills")
}

model UserSocials {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  websiteId Int     @map("website_id")
  url       String  @db.VarChar(500)
  alias     String  @db.VarChar(50)
  socials   Socials @relation(fields: [websiteId], references: [websiteId], onDelete: Cascade, map: "FK_user_socials_socials")
  users     Users   @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "FK_user_socials_users")

  @@index([userId], map: "FK_user_socials_users")
  @@index([websiteId], map: "FK_user_socials_socials")
  @@map("user_socials")
}

model Users {
  userId            Int                 @id @default(autoincrement()) @map("user_id")
  username          String              @unique @db.VarChar(50)
  ritEmail          String              @unique @map("rit_email") @db.VarChar(50)
  firstName         String              @map("first_name") @db.Text
  lastName          String              @map("last_name") @db.Text
  profileImage      String?             @map("profile_image") @db.VarChar(100)
  headline          String              @default("") @db.VarChar(100)
  pronouns          String              @default("") @db.VarChar(20)
  title             String              @default("") @db.VarChar(100)
  ritStatus         UsersRitStatus?     @map("rit_status")
  location          String              @default("") @db.VarChar(150)
  bio               String              @default("") @db.VarChar(600)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamp(0)
  phoneNumber       String?             @map("phone_number") @db.VarChar(20)
  displayPhone      Boolean             @default(false) @map("display_phone")
  googleId          String              @unique(map: "google_id_UNIQUE") @default("bill of rights") @map("google_id")
  privacy           Visibility          @default(public)
  accessLevel       AccessLevel         @default(User) @map("access_level")
  galleryEnabled    Boolean             @default(false)
  blocklistBlocked  Blocklist[]         @relation("UserToBlocked")
  blocklistBlocker  Blocklist[]         @relation("UserToBlocker")
  galleryImages     GalleryImages[]     @relation("gallery_images")
  galleryVideos     GalleryVideos[]     @relation("gallery_videos")
  memberRequest     MemberRequests[]
  members           Members[]
  receiver          Notifications[]     @relation("FK_receiver_to_notification")
  projectFollowings ProjectFollowings[]
  projects          Projects[]
  reportBug         ReportBug[]
  reportProject     ReportProject[]
  reported          ReportUser[]        @relation("reported_id")
  reporter          ReportUser[]        @relation("reporter_id")
  userBlacklists    UserBlacklist?
  followers         UserFollowings[]    @relation("receiver_user")
  following         UserFollowings[]    @relation("sender_user")
  userSkills        UserSkills[]
  userSocials       UserSocials[]
  majors            Majors[]            @relation("majorstousers")
  tagBlacklist      Tags[]              @relation("tag_blacklist")

  @@map("users")
}

model GalleryImages {
  galleryImageId Int    @id @default(autoincrement())
  image          String
  altText        String
  position       Int    @default(0)
  userId         Int
  user           Users  @relation("gallery_images", fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId], map: "gallery_images_userId_fkey")
  @@map("gallery_images")
}

model GalleryVideos {
  galleryVideoId Int    @id @default(autoincrement())
  videoUrl       String
  title          String
  position       Int    @default(0)
  userId         Int
  user           Users  @relation("gallery_videos", fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId], map: "gallery_videos_userId_fkey")
  @@map("gallery_videos")
}

model JobSkills {
  skillId     Int              @map("skill_id")
  jobId       Int              @map("job_id")
  proficiency SkillProficiency
  position    Int
  jobs        Jobs             @relation(fields: [jobId], references: [jobId], onDelete: Cascade, map: "FK_job_skills_jobs")
  skill       Skills           @relation(fields: [skillId], references: [skillId], onDelete: Cascade, map: "FK_job_skills_skills")

  @@id([jobId, skillId])
  @@index([skillId], map: "FK_job_skills_skills")
  @@map("job_skills")
}

enum JobsAvailability {
  FullTime @map("Full-time")
  PartTime @map("Part-time")
  PtFt     @map("Part-time/Full-time")

  @@map("jobs_availability")
}

enum JobsLocation {
  OnSite   @map("On-site")
  Remote
  Hybrid
  Flexible

  @@map("jobs_location")
}

enum ProjectsContext {
  Personal
  PortfolioPiece @map("Portfolio Piece")
  Academic
  CoOp           @map("Co-op")

  @@map("projects_context")
}

enum JobsCompensation {
  Unpaid
  Paid

  @@map("jobs_compensation")
}

enum ProjectsStatus {
  Planning
  Development
  PostProduction @map("Post-Production")
  Complete

  @@map("projects_status")
}

enum Visibility {
  private
  public
}

enum UsersRitStatus {
  FirstYear       @map("1st Year")
  SecondYear      @map("2nd Year")
  ThirdYear       @map("3rd Year")
  FourthYear      @map("4th Year")
  FifthYear       @map("5th Year")
  GraduateStudent @map("Graduate Student")
  Alumni
  Faculty
  Staff

  @@map("users_rit_status")
}

enum SkillProficiency {
  Novice
  Intermediate
  Advanced
  Expert
}

enum MemberRequestStatus {
  Accepted
  Declined
  Pending

  @@map("request_status")
}

enum AccessLevel {
  User
  Moderator
  Administrator

  @@map("access_level")
}
