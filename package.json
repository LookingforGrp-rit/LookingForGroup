{
  "name": "looking-for-group",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "CC0-1.0",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "prepare": "husky && npm run prisma:generate",
    "compose:up": "npx dotenv -- docker compose --file=./containers/docker-compose.yml up --build -d",
    "compose:start": "npx dotenv -- docker compose --file=./containers/docker-compose.yml start",
    "compose:down": "npx dotenv -- docker compose --file=./containers/docker-compose.yml down -v",
    "compose:stop": "npx dotenv -- docker compose --file=./containers/docker-compose.yml stop",
    "prisma:pull": "npx dotenv -- cross-env DATABASE_URL='mysql://$DB_USER:$DB_PASS@$DB_HOST:$DB_PORT/$DB_NAME' npx prisma db pull --schema=server/prisma/schema.prisma",
    "prisma:reset": "npx dotenv -- cross-env DATABASE_URL='mysql://$DB_USER:$DB_PASS@$DB_HOST:$DB_PORT/$DB_NAME' npx prisma migrate reset --schema server/prisma --force",
    "prisma:generate": "npx prisma generate --schema=server/prisma/schema.prisma",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:client",
    "start": "npm run start --workspace=server",
    "start:server": "tsx server/src/index.ts",
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "docker:build": "docker build .",
    "docker:run": "concurrently \"docker run lookingforgroup\" \"npm run dev --workspace=client\"",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "lint:server:types": "npm run lint:types --workspace=server",
    "lint:server": "npm run lint --workspace=server",
    "lint:client:types": "npm run lint:types --workspace=client",
    "lint:client": "npm run lint --workspace=client",
    "format:server": "npm run format --workspace=server"
  },
  "devDependencies": {
    "@types/css-tree": "^2.3.11",
    "@types/html-to-text": "^9.0.4",
    "@types/nodemailer": "^8.0.0",
    "@types/prismjs": "^1.26.6",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prisma": "^6.19.3",
    "vite-plugin-node-polyfills": "^0.2.0"
  },
  "engines": {
    "node": ">=v23.6.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/lab": "^9.0.0-beta.3",
    "@mui/material": "^9.0.1",
    "@prisma/client": "^6.19.3",
    "@quixo3/prisma-session-store": "^3.1.19",
    "@types/cors": "^2.8.19",
    "@types/express-serve-static-core": "^5.0.7",
    "@types/express-session": "^1.19.0",
    "@types/pug": "^2.0.10",
    "@virtuoso.dev/masonry": "^1.4.3",
    "balanced-match": "^4.0.4",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dompurify": "^3.4.11",
    "es-shim-unscopables": "^1.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vitest": "^0.5.4",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.6.2",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.1",
    "react-email": "^6.6.1",
    "react-virtuoso": "^4.18.7",
    "rollup": "^4.61.0",
    "swagger-parser": "^10.0.3",
    "tsx": "^4.20.5",
    "usehooks-ts": "^3.1.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@scarf/scarf@1.4.0": true,
    "@swc/core@1.15.43": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
